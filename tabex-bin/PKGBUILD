sha256sums=('8e5a8d1c0c0b8a5fed86be10bf7c3bcbdcbf92f40cd3c81ca3a041567d5fa091')

package() {
  install -Dm755 "tabex_v${pkgver}_linux_amd64/tabex"     "${pkgdir}/usr/bin/tabex"
}
